{
    "name": "spryker-shop/traceable-event-widget",
    "type": "library",
    "description": "TraceableEventWidget module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker-shop/shop-ui": "^1.110.0 || ^2.9.0",
        "spryker-shop/store-widget": "^1.3.0",
        "spryker/kernel": "^3.82.0",
        "spryker/kernel-app": "^1.2.0",
        "spryker/locale": "^4.8.0",
        "spryker/product-category-storage": "^2.14.0",
        "spryker/product-storage": "^1.59.0",
        "spryker/search-http": "^0.5.0",
        "spryker/store": "^1.19.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.25.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "suggest": {
        "spryker-eco/algolia": "Provides Algolia search integration for Spryker and config for this module."
    },
    "autoload": {
        "psr-4": {
            "SprykerShop\\": "src/SprykerShop/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerShopTest\\": "tests/SprykerShopTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
